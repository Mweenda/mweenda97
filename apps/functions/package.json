{
  "name": "@mweenda97/functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions backend with tRPC",
  "main": "lib/index.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@mweenda97/api": "workspace:*",
    "@mweenda97/db": "workspace:*",
    "@trpc/server": "^11.0.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
